# Copy to backend/.env for local development. All settings use the ERF_ prefix.
ERF_ENV=development
ERF_DATABASE_URL=sqlite:///./data/erf.db
ERF_BASE_URL=http://localhost:5173
ERF_TIMEZONE=Asia/Singapore
ERF_COOKIE_SECURE=false
ERF_RUN_SCHEDULER=true

# Email: "log" writes messages to the application log; "smtp" sends them.
ERF_MAIL_BACKEND=log
# ERF_MAIL_FROM=Engineering Resource Requests <no-reply@example.com>
# ERF_SMTP_HOST=smtp.gmail.com
# ERF_SMTP_PORT=587
# ERF_SMTP_USERNAME=
# ERF_SMTP_PASSWORD=
