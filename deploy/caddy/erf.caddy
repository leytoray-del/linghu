# Engineering Resource Requests. Installed to /etc/caddy/sites/erf.caddy and loaded by the
# "import /etc/caddy/sites/*.caddy" line of the main Caddyfile. ERF_DOMAIN is replaced at install time.
ERF_DOMAIN {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
		-Server
	}

	handle /api/* {
		reverse_proxy 127.0.0.1:8100
	}

	# Built files have content hashes in their names, so they can be cached for a year. A file from an
	# older release must return 404 rather than the page, so the browser notices and reloads.
	handle /assets/* {
		root * /opt/erf/current/frontend
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		root * /opt/erf/current/frontend
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
