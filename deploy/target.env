# The production server. The deployment in .github/workflows/ci.yml uses these instead of the
# DEPLOY_HOST and DEPLOY_KNOWN_HOSTS secrets and the ERF_DOMAIN variable. All three are public facts.
TARGET_HOST=35.197.69.116
TARGET_KNOWN_HOST="35.197.69.116 ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIJM84n0LJHx1R8RJ+zy3WKC7JLSM6So2yNk+qIM4sXej"
# The main address, used in email links. psbu.duckdns.org is reachable from the company network,
# which blocks freeddns.org; ers.freeddns.org stays as a second name for the same site.
TARGET_DOMAIN=psbu.duckdns.org
TARGET_ALIASES=ers.freeddns.org
# Demo mode is off: no demo accounts or data are loaded, the sign-in page has no demo panel, and emails
# go to the real recipients. This overrides the ERF_DEMO repository variable.
TARGET_DEMO=false
