# Production settings for the Engineering Resource Request system.
# Installed to /etc/erf/erf.env (readable by root and the erf group only).
ERF_ENV=production
ERF_BASE_URL=https://ERF_DOMAIN
ERF_DATABASE_URL=sqlite:////var/lib/erf/erf.db
ERF_TIMEZONE=Asia/Singapore
ERF_COOKIE_SECURE=true
ERF_RUN_SCHEDULER=true
ERF_LOG_JSON=true
ERF_SESSION_TTL_HOURS=12

# Email. "log" only writes messages to the journal (journalctl -u erf).
# For real delivery use port 587; Google Cloud blocks outbound port 25.
ERF_MAIL_BACKEND=log
ERF_MAIL_FROM="Engineering Resource Requests <no-reply@example.com>"
# ERF_SMTP_HOST=smtp.gmail.com
# ERF_SMTP_PORT=587
# ERF_SMTP_USERNAME=
# ERF_SMTP_PASSWORD=
